#!/bin/bash
# Runs every minute from cron. flock prevents overlap: the network calls below
# can exceed 60s, and two concurrent runs would race on the CSV append and on
# every state file.
cd $HOME/wind
exec /usr/bin/flock -n /home/lbgweather/var/wind-cron.lock -c '
cd $HOME/wind
(
    date -Is
    python3 wind_logger.py
    python3 bom_logger.py
    # Shadow-feed the new ingest receiver from the same cloud data, so the
    # whole server half runs on real data while production is untouched.
    # Scaffolding for the cutover - delete once the collector posts directly.
    python3 $HOME/lib/cyc/cyc_shadow_post.py --quiet
    # The watchdog itself is NOT here. It used to run from this file, which
    # meant that if cron stopped, the thing that would have noticed stopped
    # with it. It now runs from cyc-feedwatch.timer; if cron dies, status.json
    # stops being refreshed and the timer alarms.
) >> wind.log 2>&1
'
